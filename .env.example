# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that contact form submissions are sent to
CONTACT_TO_EMAIL=

# Optional: sender address. Defaults to Resend's shared sandbox sender, which
# only works while your Resend account is unverified. Once you verify a
# domain in Resend, set this to an address on that domain (e.g. contact@yourdomain.com).
CONTACT_FROM_EMAIL=
